FROM public.ecr.aws/lambda/python:3.12 as lambda-base

RUN python --version

RUN python -m pip install --upgrade setuptools pip

RUN python -m pip install \
  python-dotenv \
  boto3 \
  requests \
  pillow \
  PyNaCl \ 
  pandas

RUN dnf install git -y

