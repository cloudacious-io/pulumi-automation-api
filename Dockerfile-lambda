FROM lambda-base AS target
RUN echo "hi mom hi hihissssso"
ARG FN_CODE_REPO_URL
ARG FN_CODE_REPO_BRANCH
RUN echo ${FN_CODE_REPO_BRANCH}
WORKDIR /code
RUN git clone ${FN_CODE_REPO_BRANCH} https://${GITLAB_TOKEN_USER}:${GITLAB_TOKEN}@${FN_CODE_REPO_URL} .
RUN cp -rv . ${LAMBDA_TASK_ROOT}
